# ---- AlphaX API 环境变量示例 (复制为 .env 并填入真实值) ----
# PostgreSQL
DATABASE_URL="postgresql://alphax:alphax_dev@localhost:5433/alphax?schema=public"
# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
# Server
PORT=4000
# CORS
CORS_ORIGIN="http://localhost:3000"
WEB_URL="http://localhost:3000"
# OAuth (可选)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---- TickFlow 行情数据源 (https://tickflow.org) ----
# 在 tickflow.org 控制台生成。不配置则行情回退到内置模拟数据。
TICKFLOW_API_KEY=
# 付费端点 https://api.tickflow.org ；免费端点 https://free-api.tickflow.org
TICKFLOW_BASE_URL=https://api.tickflow.org
# true / false
TICKFLOW_ENABLED=true
# 请求超时（毫秒），默认 10000
TICKFLOW_TIMEOUT_MS=10000

# ---- TwelveData 行情数据源 (https://twelvedata.com) ----
# 现货黄金/白银 (XAUUSD/XAGUSD) 主源。免费 Key 800 credits/天, 8 req/min。
# 不配置则 XAUUSD/XAGUSD 回退到内置模拟数据。
TWELVEDATA_API_KEY=
TWELVEDATA_BASE_URL=https://api.twelvedata.com
TWELVEDATA_ENABLED=true
TWELVEDATA_TIMEOUT_MS=10000

# ---- Binance 公开行情 (加密, 免 Key) ----
# BTCUSD/ETHUSD 等加密标的。公开行情端点无需 Key。
# 部分网络环境不可达 api.binance.com 时, 可改为公开镜像 https://data-api.binance.vision
BINANCE_BASE_URL=https://api.binance.com
BINANCE_ENABLED=true
BINANCE_TIMEOUT_MS=10000

# ---- US Treasury 官方收益率 (美债, 免 Key) ----
# US10Y/US2Y/US30Y 等。美国政府公开数据, 免 Key。
TREASURY_ENABLED=true
TREASURY_TIMEOUT_MS=10000

# ---- 付费授权 (Billing) ----
# simulate=本地模拟支付（默认，可在 /billing/checkout 确认支付）; stripe=真实 Stripe（生产）
BILLING_PROVIDER=simulate
# Stripe（配置后 checkout/portal/webhook 走 Stripe）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# 演示授权码（seed 生成）：ALPHAX-PRO-DEMO-0001 / ALPHAX-ENT-DEMO-0001
